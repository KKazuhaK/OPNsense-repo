#!/bin/sh
set -eu
control=/usr/local/opnsense/scripts/mihomo/mihomo.py
install -d -m 0700 /var/db/os-mihomo
# Discard historical subscription diagnostics that may contain credentials.
if [ ! -f /var/db/os-mihomo/settings.json ]; then
    : > /var/log/mihomo_sub.log
    find /var/log -maxdepth 1 -type f -name 'mihomo_sub.log.*' -delete
fi
for log in /var/log/mihomo.log /var/log/mihomo_sub.log; do
    touch "$log"
    chmod 0640 "$log"
done
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
if [ -n "${PKG_UPGRADE+x}" ]; then
    /usr/local/bin/python3 "$control" init upgrade
else
    /usr/local/bin/python3 "$control" init fresh
fi
cron_result="$(/usr/local/bin/php /usr/local/opnsense/scripts/mihomo/setup_unbound.php restore-cron)"
case "$cron_result" in *updated*) configctl cron restart ;; esac
# Retire the known local workaround entry points after archiving them on migration.
if [ -f /var/db/os-mihomo/migrate/actions_mihomolocal.conf ]; then
    rm -f /usr/local/opnsense/service/conf/actions.d/actions_mihomolocal.conf
    rm -f /usr/local/etc/mihomo/update-sub.sh /usr/local/etc/mihomo/repair-after-upgrade.sh
fi
service configd restart
if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-mihomo
fi
# A fresh installation runs proxy ports only. Upgrade retains the explicit policy.
/usr/local/bin/python3 "$control" boot
