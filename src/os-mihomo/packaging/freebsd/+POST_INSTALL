#!/bin/sh
set -eu
control=/usr/local/opnsense/scripts/mihomo/mihomo.py
# Import the native snapshot before any defaults or service startup.
restore_ready=YES
if ! /usr/local/bin/python3 "$control" reconcile-backup; then
    restore_ready=NO
    echo 'Warning: the saved Mihomo configuration needs repair. Installation will finish with the service stopped and the saved backup retained.' >&2
fi
install -d -m 0700 /var/db/os-mihomo
# Discard historical subscription diagnostics that may contain credentials.
if [ ! -f /var/db/os-mihomo/settings.json ]; then
    : > /var/log/mihomo_sub.log
    find /var/log -maxdepth 1 -type f -name 'mihomo_sub.log.*' -delete
fi
for log in /var/log/mihomo.log /var/log/mihomo_sub.log; do
    touch "$log"
    chmod 0640 "$log"
done
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
if [ "$restore_ready" = YES ]; then
    if [ -n "${PKG_UPGRADE+x}" ]; then
        stage=upgrade
    else
        stage=fresh
    fi
    # Nothing below may abort the hook: configd, the firmware registration and
    # the proxy itself still have to run even when a step here cannot finish.
    store_ready=YES
    if ! /usr/local/bin/python3 "$control" init "$stage"; then
        store_ready=NO
        echo 'Warning: the Mihomo settings store could not be prepared. Review the plugin settings in the web interface before starting the service.' >&2
    fi
    if ! /usr/local/bin/python3 "$control" restore-cron; then
        echo 'Warning: the Mihomo subscription schedule could not be restored. Save the subscription settings once to recreate it.' >&2
    fi
    # Retire known workaround entry points only after successful migration.
    # A store that was never prepared still needs the old ones to answer for it.
    if [ "$store_ready" = YES ] && [ -f /var/db/os-mihomo/migrate/actions_mihomolocal.conf ]; then
        rm -f /usr/local/opnsense/service/conf/actions.d/actions_mihomolocal.conf
        rm -f /usr/local/etc/mihomo/update-sub.sh /usr/local/etc/mihomo/repair-after-upgrade.sh
    fi
fi
service configd restart
if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-mihomo
fi
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuha.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuha.sh mirror >/dev/null 2>&1 ||
        echo 'Warning: the installed plugin recovery manifest could not be refreshed.' >&2
fi
# A fresh installation runs proxy ports only. Upgrade retains the explicit policy.
if [ "$restore_ready" = YES ] && ! /usr/local/bin/python3 "$control" boot; then
    echo 'Warning: Mihomo could not be started. Start it from the web interface once its settings are reviewed.' >&2
fi
