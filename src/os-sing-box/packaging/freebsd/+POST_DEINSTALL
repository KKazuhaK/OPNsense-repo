#!/bin/sh

# Package upgrades keep live settings, interface assignments and runtime state.
[ -n "${PKG_UPGRADE+x}" ] && exit 0
rm -rf /var/db/os-singbox-backup
rm -f /var/run/sing-box-backup.pid /var/log/sing-box-backup.log

echo "===> Refreshing OPNsense menu cache"
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
rm -f /usr/local/opnsense/service/conf/actions.d/actions_sing-box.conf
service configd restart >/dev/null 2>&1 || true

# Keep private settings and recovery journals for a later reinstall or review.
# No delayed recursive removal may race another installation.
