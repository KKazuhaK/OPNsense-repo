#!/bin/sh
set -eu

# Pkg runs the incoming pre-install before deleting old package-owned files.
# Preserve only this plugin's live files while moving ownership to samples.
[ -n "${PKG_UPGRADE+x}" ] || exit 0
if [ -f /usr/local/opnsense/scripts/singbox/config_mirror.py ]; then
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/config_mirror.py mirror >/dev/null 2>&1 \
        || echo 'Warning: Sing-box configuration backup could not be synchronized.' >&2
fi
service sing-box-backup onestop >/dev/null 2>&1 || true
BACKUP_DIR="/var/db/os-sing-box-upgrade"
[ ! -L "$BACKUP_DIR" ] || exit 1
umask 077
mkdir -p "$BACKUP_DIR"
chmod 0700 "$BACKUP_DIR"
for relative in config.json sub/env sub/template.json; do
    source="/usr/local/etc/sing-box/$relative"
    destination="$BACKUP_DIR/$relative"
    if [ -f "$source" ]; then
        mkdir -p "$(dirname "$destination")"
        install -m 0600 "$source" "$destination"
    fi
done
if [ -f /etc/rc.conf.d/sing_box ]; then
    install -m 0600 /etc/rc.conf.d/sing_box "$BACKUP_DIR/sing_box"
fi
rm -f "$BACKUP_DIR/running"
PROCESS_ALIVE="no"
if [ -f /usr/local/opnsense/scripts/singbox/integration.py ]; then
    status_json="$(/usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py status 2>/dev/null || true)"
    if printf '%s' "$status_json" | /usr/local/bin/python3 -c \
        'import json,sys; value=json.load(sys.stdin); sys.exit(0 if value.get("ok") is True and value.get("process_alive") is True else 1)' \
        >/dev/null 2>&1; then
        PROCESS_ALIVE="yes"
    fi
fi
if [ "$PROCESS_ALIVE" = "yes" ] || service sing-box status >/dev/null 2>&1; then
    touch "$BACKUP_DIR/running"
fi
