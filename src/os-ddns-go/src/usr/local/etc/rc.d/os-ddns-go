#!/bin/sh

# PROVIDE: ddnsgo
# REQUIRE: NETWORKING ddnsgo_backup LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="ddnsgo"
rcvar="ddnsgo_enable"

pidfile="/var/run/${name}.pid"

# Reconcile restored XML before reading service enable and configuration paths.
case "${1:-}" in
    start|onestart|faststart|forcestart)
        /usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/process_control.py idle "$pidfile" "${name}:daemon" /usr/local/bin/ddns-go || exit 1
        /usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py reconcile >/dev/null || exit 1
        ;;
esac

backup_force_restart=no
case "${1:-}" in
    onerestart|forcerestart) backup_force_restart=yes ;;
esac

load_rc_config "$name"

: "${ddnsgo_enable:=YES}"
: "${ddnsgo_config:=/usr/local/etc/ddns-go/config.yaml}"
: "${ddnsgo_listen:=:9876}"
: "${ddnsgo_interval:=300}"
: "${ddnsgo_extra_args:=}"

logfile="/var/log/${name}.log"
command="/usr/sbin/daemon"
ddnsgo_bin="/usr/local/bin/ddns-go"

start_precmd="${name}_prestart"
start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
restart_cmd="${name}_restart"

ddnsgo_prestart()
{
	if [ ! -x "$ddnsgo_bin" ]; then
		echo "ddns-go binary not found at $ddnsgo_bin"
		return 1
	fi

	# Refuse foreign PIDs before modifying service files.
	ddnsgo_control status >/dev/null 2>&1 && return 1
	ddnsgo_control stop || return $?
	mkdir -p "$(dirname "$ddnsgo_config")"
	touch "$logfile"
	chmod 0600 "$logfile"
}

ddnsgo_start()
{
	# shellcheck disable=SC2086
	$command -P "$pidfile" -f -o "$logfile" -t "${name}:daemon" \
		"$ddnsgo_bin" -c "$ddnsgo_config" -l "$ddnsgo_listen" -f "$ddnsgo_interval" $ddnsgo_extra_args || return $?
	ddnsgo_control record || { ddnsgo_control stop; return 1; }
	/usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py mirror >/dev/null
}

ddnsgo_control()
{
	# shellcheck disable=SC2086
	/usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/process_control.py "$1" "$pidfile" "${name}:daemon" "$ddnsgo_bin" -c "$ddnsgo_config" -l "$ddnsgo_listen" -f "$ddnsgo_interval" $ddnsgo_extra_args
}

ddnsgo_stop()
{
	ddnsgo_control stop || return $?
	if [ "${1:-}" != "skip-backup" ]; then
		/usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py mirror >/dev/null
	fi
}

ddnsgo_restart()
{
    # Stop embedded writers before applying a newly restored XML snapshot.
    ddnsgo_stop skip-backup || return $?
    /usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py reconcile >/dev/null || return $?
    unset ddnsgo_enable ddnsgo_config ddnsgo_listen ddnsgo_interval ddnsgo_extra_args
    load_rc_config "$name"
	: "${ddnsgo_enable:=YES}"
	: "${ddnsgo_config:=/usr/local/etc/ddns-go/config.yaml}"
	: "${ddnsgo_listen:=:9876}"
	: "${ddnsgo_interval:=300}"
	: "${ddnsgo_extra_args:=}"
    if [ "$backup_force_restart" = "no" ] && ! checkyesno "$rcvar"; then
        /usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py mirror >/dev/null
        return $?
    fi
    ddnsgo_prestart || return $?
    ddnsgo_start
}

ddnsgo_status()
{
	if ddnsgo_control status; then
		echo "${name} is running."
		return 0
	fi
	echo "${name} is not running."
	return 1
}

run_rc_command "$1"
