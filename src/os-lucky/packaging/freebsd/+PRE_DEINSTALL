#!/bin/sh

service os-lucky onestop >/dev/null 2>&1 \
    || { echo 'Scoped Lucky shutdown failed; refusing unsafe removal.' >&2; exit 1; }
/usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/config_mirror.py mirror >/dev/null 2>&1 || true
service os-lucky-backup onestop >/dev/null 2>&1 || true
exit 0
