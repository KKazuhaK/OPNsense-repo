#!/bin/sh

# Package upgrades must keep the existing runtime configuration.
[ -n "${PKG_UPGRADE+x}" ] && exit 0

rm -f /etc/rc.conf.d/staticarp
rm -rf /usr/local/etc/staticarp
rm -f \
	/var/lib/php/tmp/opnsense_menu_cache.xml \
	/var/lib/php/tmp/opnsense_acl_cache.json

service configd restart >/dev/null 2>&1 || true

exit 0
