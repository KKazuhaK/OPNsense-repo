#!/bin/sh
set -eu
if [ -f /usr/local/opnsense/scripts/singbox/config_mirror.py ]; then
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/config_mirror.py mirror >/dev/null 2>&1 \
        || echo 'Warning: Sing-box configuration backup could not be synchronized.' >&2
fi
service sing-box-backup onestop >/dev/null 2>&1 || true
[ -n "${PKG_UPGRADE+x}" ] && exit 0
# The service stops only an exact journal-owned or validated legacy instance.
service sing-box onestop >/dev/null 2>&1 \
    || { echo 'Scoped Sing-box shutdown failed; refusing unsafe removal.' >&2; exit 1; }
if REMOVE_RESULT="$(/usr/local/bin/php /usr/local/opnsense/scripts/singbox/config_setup.php remove 2>/dev/null)"; then
    :
else
    echo 'Scoped Sing-box interface cleanup failed.' >&2
    exit 1
fi
case "$REMOVE_RESULT" in
    changed) ;;
    unchanged) ;;
    *)
        echo 'Scoped Sing-box interface cleanup returned an invalid result.' >&2
        exit 1
        ;;
esac
if ! /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py reload-filter >/dev/null 2>&1; then
    echo 'A pending Sing-box firewall configuration reload could not be completed.' >&2
    exit 1
fi
