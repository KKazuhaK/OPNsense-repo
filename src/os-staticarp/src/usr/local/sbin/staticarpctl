#!/bin/sh

set -eu

CONFIG_DIR="/usr/local/etc/staticarp"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"
ENTRIES_FILE="$CONFIG_DIR/entries.conf"
INTERFACES_FILE="$CONFIG_DIR/interfaces.conf"
LOCK_FILE="/var/db/os-staticarp-backup/settings.lock"

get_setting() {
	key="$1"
	default="$2"
	if [ -r "$SETTINGS_FILE" ]; then
		value="$(awk -F= -v key="$key" '$1 == key {print substr($0, index($0, "=") + 1); exit}' "$SETTINGS_FILE")"
		if [ -n "$value" ]; then
			printf '%s\n' "$value"
			return
		fi
	fi
	printf '%s\n' "$default"
}

case "${1:-apply}" in
	apply|reset)
		# Keep settings, bindings and interface modes from the same completed save.
		# The lock file remains present; removing it would split concurrent locks.
		(umask 077; mkdir -p "$(dirname "$LOCK_FILE")")
		/usr/bin/lockf -k -t 10 "$LOCK_FILE" /bin/sh "$0" "_${1:-apply}"
		# Mirroring acquires its own operation lock and then this settings lock.
		# Run it only after the child and its settings lock have been released.
		/usr/local/bin/python3 /usr/local/opnsense/scripts/staticarp/config_mirror.py mirror >/dev/null
		printf 'OK\n'
		;;
	_apply|_reset)
		/usr/local/bin/python3 /usr/local/opnsense/scripts/staticarp/runtime.py "${1#_}"
		;;
	status)
		printf 'enabled=%s\n' "$(get_setting enabled NO)"
		printf 'entries=%s\n' "$(awk '$0 !~ /^[[:space:]]*(#|$)/ {count++} END {print count + 0}' "$ENTRIES_FILE" 2>/dev/null || printf 0)"
		;;
	*)
		echo "usage: staticarpctl [apply|reset|status]" >&2
		exit 64
		;;
esac

exit 0
