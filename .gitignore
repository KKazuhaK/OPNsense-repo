# These rules protect this repository only. A branch based on an upstream whose
# .gitignore is smaller does not inherit them, so `git add -A` there will sweep
# up build output, caches and local instruction files. Name the files explicitly
# when committing against someone else's base.

.DS_Store
._*
.private/
work/

# Signing private keys must never be committed.
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
pkgsign/
.secrets/
.env
.env.*

# Keep AI instructions, memory, and tool configuration local.
AGENT.md
agent.md
AGENTS.md
agents.md
AGENTS.override.md
agents.override.md
CLAUDE.md
claude.md
CLAUDE.local.md
claude.local.md
GEMINI.md
gemini.md
MEMORY.md
memory.md
HANDOFF.md
handoff.md
.agent/
.agents/
.codex/
.claude/
.gemini/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.aider*
.idea/
.vscode/
.github/copilot-instructions.md

# Generated packages and repository catalogs are published separately.
/repo/
/SHA256SUMS.txt
/.site/
dist/
dist-*/
__pycache__/
*.pyc
*.pyo
