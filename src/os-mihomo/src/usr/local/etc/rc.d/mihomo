#!/bin/sh
# PROVIDE: mihomo
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr
name="mihomo"
rcvar="mihomo_enable"
: "${mihomo_enable:=YES}"
requested_action="$1"
control="/usr/local/opnsense/scripts/mihomo/mihomo.py"
start_cmd="mihomo_start"
stop_cmd="mihomo_stop"
restart_cmd="mihomo_restart"
status_cmd="mihomo_status"

mihomo_start() { /usr/local/bin/python3 "$control" boot; }
mihomo_stop()
{
    case "$requested_action" in
        faststop) /usr/local/bin/python3 "$control" suspend ;;
        *) /usr/local/bin/python3 "$control" stop ;;
    esac
}
mihomo_restart() { /usr/local/bin/python3 "$control" restart; }
mihomo_status()
{
    output="$(/usr/local/bin/python3 "$control" --json status)" || return $?
    printf '%s\n' "$output"
    # rc.subr expects a non-zero status when the service is not running. The
    # manager answers both states with JSON and exit zero, so read the running
    # flag instead of treating the JSON text as a protocol.
    printf '%s' "$output" | /usr/local/bin/python3 -c \
        'import json,sys; r=json.load(sys.stdin).get("result"); sys.exit(0 if isinstance(r,dict) and r.get("running") else 1)'
}
load_rc_config "$name"
run_rc_command "$1"
