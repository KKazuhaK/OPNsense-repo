#!/bin/sh
set -eu

if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-sing-box >/dev/null 2>&1 || true
fi
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuha.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuha.sh mirror >/dev/null 2>&1 \
        || echo 'Warning: Kazuha plugin restore manifest could not be updated.' >&2
fi

echo "===> Configuring os-sing-box"

BACKUP_DIR="/var/db/os-sing-box-upgrade"
NEW_SETTINGS=""
WAS_RUNNING="no"
IS_UPGRADE="no"
RESTORED_SETTINGS="no"
RESTORE_FAILED="no"
[ -z "${PKG_UPGRADE+x}" ] || IS_UPGRADE="yes"
umask 077
if restore_result="$(/usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/config_mirror.py import-config 2>/dev/null)"; then
    :
else
    RESTORE_FAILED="yes"
    RESTORED_SETTINGS="yes"
    echo 'Warning: Sing-box configuration backup could not be restored.' >&2
fi
if printf '%s' "$restore_result" | /usr/local/bin/python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("snapshot") else 1)' 2>/dev/null; then
    RESTORED_SETTINGS="yes"
fi
mkdir -p /etc/rc.conf.d
if [ "$RESTORED_SETTINGS" = "no" ]; then
    mkdir -p /usr/local/etc/sing-box/sub
    chmod 0700 /usr/local/etc/sing-box /usr/local/etc/sing-box/sub
fi
if [ -d "$BACKUP_DIR" ] && [ ! -L "$BACKUP_DIR" ]; then
    [ ! -f "$BACKUP_DIR/running" ] || WAS_RUNNING="yes"
fi
if [ "$RESTORED_SETTINGS" = "no" ] && [ -d "$BACKUP_DIR" ] && [ ! -L "$BACKUP_DIR" ]; then
    for relative in config.json sub/env sub/template.json; do
        destination="/usr/local/etc/sing-box/$relative"
        if [ ! -f "$destination" ] && [ -f "$BACKUP_DIR/$relative" ]; then
            install -m 0600 "$BACKUP_DIR/$relative" "$destination"
        fi
    done
    if [ ! -f /etc/rc.conf.d/sing_box ] && [ -f "$BACKUP_DIR/sing_box" ]; then
        install -m 0644 "$BACKUP_DIR/sing_box" /etc/rc.conf.d/sing_box
    fi
fi
if [ "$RESTORED_SETTINGS" = "no" ]; then
    for relative in config.json sub/env sub/template.json; do
        destination="/usr/local/etc/sing-box/$relative"
        if [ ! -f "$destination" ]; then
            install -m 0600 "$destination.sample" "$destination"
            NEW_SETTINGS="$NEW_SETTINGS $destination"
        fi
    done
    if [ ! -f /etc/rc.conf.d/sing_box ]; then
        install -m 0644 /etc/rc.conf.d/sing_box.sample /etc/rc.conf.d/sing_box
    fi
fi
touch /var/log/sing-box.log /var/log/sing-box_sub.log 2>/dev/null || true
[ "$RESTORED_SETTINGS" = "yes" ] || chmod 0755 /usr/local/etc/sing-box/sub/sub.sh 2>/dev/null || true
rm -f /usr/local/www/sing-box.php /usr/local/www/sing-box_log.php /usr/local/www/sing-box_sub.php /usr/local/www/sing-box_sub_log.php
rm -f /usr/local/www/services_sub.php /usr/local/www/status_sing_box_logs.php
rm -f /usr/local/www/services_sing_box.php /usr/local/www/status_sing_box.php
rm -f /usr/local/www/services_singboxsub.php /usr/local/www/status_singboxsub_log.php
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
rm -rf /usr/local/opnsense/mvc/app/models/OPNsense/sing-box

if command -v openssl >/dev/null 2>&1; then
    CLASH_API_SECRET="$(openssl rand -hex 24)"
elif command -v uuidgen >/dev/null 2>&1; then
    CLASH_API_SECRET="$(uuidgen | tr -d '-')"
else
    CLASH_API_SECRET="$(date | cksum | awk '{print $1}')"
fi
for secret_file in $NEW_SETTINGS; do
    case "$secret_file" in
        */config.json|*/template.json)
        secret_script="$(mktemp "${secret_file}.secret.XXXXXX")"
        secret_temporary="$(mktemp "${secret_file}.XXXXXX")"
        printf 's/"secret": "CHANGE_ME"/"secret": "%s"/\ns/"secret": ""/"secret": "%s"/\n' \
            "$CLASH_API_SECRET" "$CLASH_API_SECRET" > "$secret_script"
        sed -f "$secret_script" "$secret_file" > "$secret_temporary"
        chmod 0600 "$secret_temporary"
        mv "$secret_temporary" "$secret_file"
        rm -f "$secret_script"
        ;;
    esac
done
if [ "$RESTORED_SETTINGS" = "no" ]; then
    chmod 0600 /usr/local/etc/sing-box/config.json 2>/dev/null || true
    chmod 0600 /usr/local/etc/sing-box/sub/env /usr/local/etc/sing-box/sub/template.json 2>/dev/null || true
fi
if [ "$RESTORE_FAILED" = "no" ] && [ -d "$BACKUP_DIR" ]; then
    rm -rf "$BACKUP_DIR"
fi

# First installation prepares an explicit proxy-only policy, without TUN rules.
if [ "$RESTORE_FAILED" = "no" ] && [ -f /usr/local/etc/sing-box/config.json ]; then
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py init >/dev/null 2>&1 \
        || echo 'Warning: Sing-box integration settings could not be initialized.' >&2
fi

# Version 1.1.1 had no ownership journal. Remove only its exact generated rule
# and an exact, otherwise unreferenced interface assignment during the upgrade.
if [ "$IS_UPGRADE" = "yes" ]; then
    if LEGACY_RESULT="$(/usr/local/bin/php /usr/local/opnsense/scripts/singbox/config_setup.php retire-legacy 2>/dev/null)"; then
        :
    else
        echo 'Exact legacy Sing-box TUN policy retirement failed.' >&2
        exit 1
    fi
    case "$LEGACY_RESULT" in
        changed) ;;
        unchanged) ;;
        *)
            echo 'Exact legacy Sing-box TUN policy retirement returned an invalid result.' >&2
            exit 1
            ;;
    esac
fi

echo "===> Reloading OPNsense services"
service configd restart >/dev/null 2>&1 || true
if ! /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py reload-filter >/dev/null 2>&1; then
    echo 'A pending Sing-box firewall configuration reload could not be completed.' >&2
    exit 1
fi
if [ "$RESTORE_FAILED" = "no" ]; then
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/config_mirror.py mirror >/dev/null 2>&1 \
        || echo 'Warning: Sing-box configuration backup could not be synchronized.' >&2
fi
service sing-box-backup onerestart >/dev/null 2>&1 || true
if [ "$RESTORE_FAILED" = "yes" ]; then
    :
elif [ "$WAS_RUNNING" = "yes" ]; then
    service sing-box onerestart >/dev/null 2>&1 || true
fi
