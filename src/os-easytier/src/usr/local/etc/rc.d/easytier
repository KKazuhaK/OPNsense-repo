#!/bin/sh
# PROVIDE: easytier
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr
name="easytier"
rcvar="easytier_enable"
desc="EasyTier mesh VPN"
command="/usr/local/bin/python3"
pidfile="/var/run/easytier.pid"
network="/usr/local/opnsense/scripts/easytier/network.py"
start_cmd="easytier_start"
stop_cmd="easytier_stop"
status_cmd="easytier_status"

easytier_start()
{
    /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/config_mirror.py reconcile >/dev/null || return 1
    /usr/local/bin/python3 "${network}" enabled || return 1
    /usr/local/bin/python3 "${network}" check || return 1
    if /usr/local/bin/python3 "${network}" status >/dev/null 2>&1; then
        return 0
    fi
    install -d -m 0700 /var/run/easytier-network
    touch /var/log/easytier.log
    chmod 0600 /var/log/easytier.log
    /usr/sbin/daemon -p /var/run/easytier-network/supervisor.pid -o /var/log/easytier.log \
        -t easytier /usr/local/bin/python3 "${network}" run || return 1
    count=0
    while [ "${count}" -lt 20 ]; do
        /usr/local/bin/python3 "${network}" status >/dev/null 2>&1 && return 0
        sleep 1
        count=$((count + 1))
    done
    /usr/local/bin/python3 "${network}" stop >/dev/null 2>&1 || true
    echo "EasyTier did not start. Check its private log and VPN configuration."
    return 1
}

easytier_stop()
{
    rm -f /var/db/os-easytier/runtime.resume.upgrade
    /usr/local/bin/python3 "${network}" stop
}

easytier_status()
{
    /usr/local/bin/python3 "${network}" status
}

: ${easytier_enable:="NO"}
load_rc_config "${name}"
run_rc_command "$1"
