#!/bin/sh
set -eu

if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-easytier >/dev/null 2>&1 || true
fi
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuha.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuha.sh mirror >/dev/null 2>&1 \
        || echo 'Warning: Kazuha plugin restore manifest could not be updated.' >&2
fi

# Begin upgrade state restore.
if [ ! -f /etc/rc.conf.d/easytier ] && [ -f /var/db/os-easytier/rc.conf.upgrade ]; then
    mkdir -p /etc/rc.conf.d
    cp -p /var/db/os-easytier/rc.conf.upgrade /etc/rc.conf.d/easytier
fi
rm -f /var/db/os-easytier/rc.conf.upgrade
# End upgrade state restore.

# Remove the retired entry point when upgrading from the legacy page.
rm -f /usr/local/www/easytier.php
result="$(/usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/config_mirror.py import-config)" || exit 1
snapshot="$(printf '%s' "$result" | /usr/local/bin/python3 -c 'import json,sys; result=json.load(sys.stdin); sys.exit(1) if not result.get("ok") else print("yes" if result.get("snapshot") else "no")')" || exit 1
mkdir -p /var/log
if [ "$snapshot" = no ]; then
    mkdir -p /etc/rc.conf.d /usr/local/etc/easytier
    if [ ! -e /etc/rc.conf.d/easytier ]; then
        install -m 0644 /etc/rc.conf.d/easytier.sample /etc/rc.conf.d/easytier
    fi
    if [ ! -e /usr/local/etc/easytier/config.toml ]; then
        install -m 0600 /usr/local/etc/easytier/config.toml.sample /usr/local/etc/easytier/config.toml
    fi
    chmod 0600 /usr/local/etc/easytier/config.toml
fi
touch /var/log/easytier.log
chmod 0600 /var/log/easytier.log
/usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/config_mirror.py mirror >/dev/null || echo 'Warning: EasyTier configuration backup could not be updated.' >&2
service os-easytier-backup onestart >/dev/null 2>&1 || echo 'Warning: EasyTier configuration backup watcher could not be started.' >&2

service configd restart >/dev/null 2>&1 || true
# Retire only a verified legacy rule without reloading native PF.
/usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/retire_legacy.py
# OPNsense caches the merged sidebar model for up to one hour.  Invalidate it
# so the newly installed VPN menu entry is visible on the next page request.
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json

# Restore only recorded running intent, never merely an enabled rc variable.
resume=/var/db/os-easytier/runtime.resume.upgrade
if [ -f "$resume" ]; then
    if /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/network.py enabled >/dev/null 2>&1 \
        && service easytier start \
        && /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/network.py status >/dev/null 2>&1; then
        rm -f "$resume"
    else
        echo 'Warning: The previously running EasyTier service could not be restored. Its retry marker was preserved; check the private log and retry the upgrade or start it explicitly.' >&2
    fi
fi
echo "EasyTier installed. Open VPN > EasyTier to configure it."
