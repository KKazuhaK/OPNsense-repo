#!/bin/sh

# PROVIDE: sing_box
# REQUIRE: NETWORKING
# KEYWORD: shutdown

# shellcheck disable=SC1091
. /etc/rc.subr

name="sing_box"
# shellcheck disable=SC2034
rcvar="sing_box_enable"

pidfile="/var/run/sing-box.pid"
logfile="/var/log/sing-box.log"
command="/usr/local/bin/sing-box"
config="/usr/local/etc/sing-box/config.json"

# shellcheck disable=SC2034
start_cmd="${name}_start"
# shellcheck disable=SC2034
stop_cmd="${name}_stop"
# shellcheck disable=SC2034
status_cmd="${name}_status"

# Restore before reading service variables or checking the enabled state.
# Restart loads the old state first so its stop uses the running daemon's PID.
case "$1" in
    start|onestart|faststart|forcestart|quietstart)
        if ! /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/config_mirror.py reconcile >/dev/null 2>&1; then
            echo "Unable to prepare the restored Sing-box configuration."
            exit 1
        fi
        ;;
esac

load_rc_config $name
: "${sing_box_enable:=no}"

sing_box_start() {
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py start --config "$config" --pidfile "$pidfile"
}

sing_box_stop() {
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py stop --config "$config" --pidfile "$pidfile"
}

sing_box_status() {
    /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/integration.py status
}

case "$1" in
    restart|onerestart|fastrestart|forcerestart|quietrestart)
        run_rc_command onestop || exit $?
        # A fresh process also clears overrides removed by the restored RC file.
        next_action="${1%restart}start"
        unset sing_box_enable
        exec /bin/sh "$0" "$next_action"
        ;;
    *) run_rc_command "$1" ;;
esac
