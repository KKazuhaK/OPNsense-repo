#!/usr/local/bin/python3
"""Run the real resolver with synthetic templates inside the VNET jail."""
from pathlib import Path
import ipaddress
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
args = sys.argv[1:]
with Path('/root/actions.log').open('a') as stream:
    stream.write('configctl ' + ' '.join(args) + '\n')
if Path('/root/fail-configctl').exists():
    print('Execute error')
    sys.exit(0)
if args == ['filter', 'reload']:
    # Only configd's context/template plumbing is synthetic. Invoke the
    # packaged context parser against genuine jail ifconfig output, and let
    # the manager invoke the unchanged native routing.py separately.
    root = ET.parse('/conf/config.xml').getroot()
    mapping = {node.tag: {child.tag: child.text or '' for child in node}
               for node in root.findall('./interfaces/*')}
    php = '''require_once('/usr/local/etc/inc/plugins.inc.d/mihomo.inc');
        echo json_encode(mihomo_routing_context(json_decode(stream_get_contents(STDIN), true),
            explode("\\n", shell_exec('/sbin/ifconfig -a'))), JSON_THROW_ON_ERROR);'''
    result = subprocess.run(['/usr/local/bin/php', '-r', php], input=json.dumps(mapping).encode(),
                            capture_output=True, check=True)
    context = json.loads(result.stdout)
    descriptor, temporary = tempfile.mkstemp(prefix='.routing-context-test-', dir='/var/db/os-mihomo')
    try:
        with os.fdopen(descriptor, 'w') as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(context, stream)
        os.replace(temporary, '/var/db/os-mihomo/routing-context.json')
    finally:
        Path(temporary).unlink(missing_ok=True)
    # A non-quick head anchor selects a FIB without granting permission.
    # This lifecycle-only jail has no LAN clients; packet policy is tested
    # separately with the three-party native PF/Core fixture.
    rules = ['set skip on lo0', 'anchor "mihomo" all']
    if any(mapping.get(rule.findtext('interface'), {}).get('if') == 'tun_mihomo'
           for rule in root.findall('./filter/rule')):
        rules.append('pass in on tun_mihomo inet from any to any keep state')
    rules.extend(['pass in all keep state', 'pass out all keep state'])
    Path('/root/filter-test.conf').write_text('\n'.join(rules) + '\n')
    subprocess.run(['/sbin/pfctl', '-nf', '/root/filter-test.conf'], check=True)
    subprocess.run(['/sbin/pfctl', '-f', '/root/filter-test.conf'], check=True)
    sys.exit(0)
if args == ['dns', 'reload']:
    # This adapter models only the generated private fixture's DNS settings.
    # Genuine OPNsense configd/template behavior requires the separate host test.
    system = ET.parse('/conf/config.xml').find('system')
    if system is None:
        raise RuntimeError('The private DNS fixture has no system configuration.')
    domain = system.findtext('domain') or 'localdomain'
    if re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.-]*', domain) is None:
        raise RuntimeError('The private DNS fixture has an invalid search domain.')
    servers = [] if system.find('dnslocalhost') is not None else ['127.0.0.1']
    for node in system.findall('dnsserver'):
        address = str(ipaddress.ip_address(node.text or ''))
        if address not in servers:
            servers.append(address)
    if not servers:
        raise RuntimeError('The private DNS fixture has no resolver.')
    content = 'search ' + domain + '\n' + ''.join('nameserver ' + address + '\n' for address in servers)
    descriptor, temporary = tempfile.mkstemp(prefix='.resolv-test-', dir='/etc')
    try:
        with os.fdopen(descriptor, 'w') as stream:
            os.fchmod(stream.fileno(), 0o644)
            stream.write(content)
        os.replace(temporary, '/etc/resolv.conf')
    finally:
        Path(temporary).unlink(missing_ok=True)
    sys.exit(0)
if args == ['template', 'reload', 'OPNsense/Unbound']:
    Path('/var/unbound/unbound.conf').write_text('''server:
  interface: 127.0.0.1
  port: 53
  username: ""
  chroot: ""
  directory: /var/unbound
  pidfile: /var/run/unbound.pid
  use-syslog: no
  local-zone: "policy.test." static
  local-data: "policy.test. IN A 192.0.2.20"
''')
if args == ['unbound', 'restart']:
    if Path('/var/run/unbound.pid').exists():
        subprocess.run(['/usr/bin/pkill', '-F', '/var/run/unbound.pid'])
        time.sleep(.1)
    subprocess.run(['/usr/local/sbin/unbound', '-c', '/var/unbound/unbound.conf'], check=True)
    time.sleep(.2)
