#!/bin/sh

service configd restart >/dev/null 2>&1 || true
/usr/local/opnsense/scripts/firmware/register.php install os-unboundcustom >/dev/null 2>&1 || true
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuha.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuha.sh mirror >/dev/null 2>&1 \
        || echo 'Warning: Kazuha plugin restore manifest could not be updated.' >&2
fi
/usr/local/bin/python3 /usr/local/opnsense/scripts/OPNsense/Unboundcustom/apply.py install || {
    echo 'Warning: Unbound custom options could not be applied. Previous DNS configuration was retained.' >&2
}
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml
exit 0
