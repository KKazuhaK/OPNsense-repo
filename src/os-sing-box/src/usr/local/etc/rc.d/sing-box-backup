#!/bin/sh

# PROVIDE: sing_box_backup
# REQUIRE: FILESYSTEMS
# KEYWORD: shutdown

. /etc/rc.subr

name="sing_box_backup"
rcvar="sing_box_backup_enable"
load_rc_config "$name"
: "${sing_box_backup_enable:=YES}"
pidfile="/var/run/sing-box-backup.pid"
command="/usr/sbin/daemon"
start_cmd="sing_box_backup_start"
stop_cmd="sing_box_backup_stop"
status_cmd="sing_box_backup_status"

sing_box_backup_status()
{
    [ -f "$pidfile" ] || return 1
    watcher_pid="$(cat "$pidfile")"
    case "$watcher_pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$watcher_pid" 2>/dev/null || return 1
    case "$(ps -p "$watcher_pid" -o args=)" in
        *sing-box-backup*) return 0 ;;
        *) return 1 ;;
    esac
}

sing_box_backup_start()
{
    sing_box_backup_status && return 0
    touch /var/log/sing-box-backup.log
    chmod 0600 /var/log/sing-box-backup.log
    "$command" -P "$pidfile" -r -f -o /var/log/sing-box-backup.log -t sing-box-backup \
        /usr/local/bin/python3 /usr/local/opnsense/scripts/singbox/config_mirror.py watch
}

sing_box_backup_stop()
{
    if sing_box_backup_status; then
        pkill -TERM -P "$watcher_pid" 2>/dev/null || true
        kill -TERM "$watcher_pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
}

run_rc_command "$1"
