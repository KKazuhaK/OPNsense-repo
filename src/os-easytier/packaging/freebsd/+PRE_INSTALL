#!/bin/sh
set -eu

if [ -f /usr/local/opnsense/scripts/easytier/config_mirror.py ]; then
    if /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/config_mirror.py reconcile >/dev/null; then
        /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/config_mirror.py mirror >/dev/null \
            || echo 'Warning: EasyTier configuration backup could not be updated before upgrade.' >&2
    else
        echo 'Warning: EasyTier configuration backup could not be reconciled before upgrade.' >&2
    fi
fi

# pkg runs this before deleting the old version's package-owned rc file.
state=/var/db/os-easytier
live=/etc/rc.conf.d/easytier
backup="$state/rc.conf.upgrade"
if [ -f "$live" ]; then
    install -d -m 0700 "$state"
    temporary="$(mktemp "$state/rc.conf.XXXXXXXX")"
    trap 'rm -f "$temporary"' EXIT HUP INT TERM
    cp -p "$live" "$temporary"
    mv -f "$temporary" "$backup"
    trap - EXIT HUP INT TERM
fi

# Capture a currently supervised instance before future upgrades remove it.
# Historical package hooks can stop Core before this hook is reached; in that
# case do not guess that enabled means running, and require an explicit Start.
resume="$state/runtime.resume.upgrade"
if [ -f /usr/local/opnsense/scripts/easytier/network.py ] \
    && /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/network.py enabled >/dev/null 2>&1; then
    if /usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/network.py status >/dev/null 2>&1; then
        install -d -m 0700 "$state"
        (umask 077; printf '%s\n' supervised-running > "$resume")
    fi
else
    # An explicit disable or removal cancels any retry left by a failed upgrade.
    rm -f "$resume"
fi
