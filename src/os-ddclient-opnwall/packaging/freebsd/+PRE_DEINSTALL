#!/bin/sh

/usr/local/etc/rc.d/ddclient_opnwall_perl onestop >/dev/null 2>&1 \
    || { echo 'Scoped Perl DDClient shutdown failed; refusing unsafe removal.' >&2; exit 1; }
/usr/local/etc/rc.d/ddclient_opn onestop >/dev/null 2>&1 \
    || { echo 'Scoped Python DDClient shutdown failed; refusing unsafe removal.' >&2; exit 1; }
exit 0
