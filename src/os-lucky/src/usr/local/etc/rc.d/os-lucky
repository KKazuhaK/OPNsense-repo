#!/bin/sh

# PROVIDE: lucky
# REQUIRE: NETWORKING lucky_backup
# KEYWORD: shutdown

. /etc/rc.subr

name="lucky"
rcvar="lucky_enable"

pidfile="/var/run/${name}.pid"

# Reconcile restored XML before reading service enable and configuration paths.
case "${1:-}" in
    start|onestart|faststart|forcestart)
        /usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/process_control.py idle "$pidfile" "${name}:daemon" /usr/local/bin/lucky || exit 1
        /usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/config_mirror.py reconcile >/dev/null || exit 1
        ;;
esac

backup_force_restart=no
case "${1:-}" in
    onerestart|forcerestart) backup_force_restart=yes ;;
esac

load_rc_config "$name"

: "${lucky_enable:=YES}"
: "${lucky_conf_dir:=/usr/local/etc/lucky}"
: "${lucky_http_port:=16601}"

logfile="/var/log/${name}.log"
command="/usr/sbin/daemon"
lucky_bin="/usr/local/bin/lucky"

start_precmd="${name}_prestart"
start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
restart_cmd="${name}_restart"

lucky_prestart()
{
	if [ ! -x "$lucky_bin" ]; then
		echo "lucky binary not found at $lucky_bin"
		return 1
	fi

	# Refuse foreign PIDs before modifying service files.
	lucky_control status >/dev/null 2>&1 && return 1
	lucky_control stop || return $?
	mkdir -p "$lucky_conf_dir"
	touch "$logfile"
	chmod 0600 "$logfile"
}

lucky_start()
{
	$command -P "$pidfile" -f -o "$logfile" -t "${name}:daemon" \
		"$lucky_bin" -cd "$lucky_conf_dir" -port "$lucky_http_port" || return $?
	lucky_control record || { lucky_control stop; return 1; }
	/usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/config_mirror.py mirror >/dev/null
}

lucky_control()
{
	/usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/process_control.py "$1" "$pidfile" "${name}:daemon" "$lucky_bin" -cd "$lucky_conf_dir" -port "$lucky_http_port"
}

lucky_stop()
{
	lucky_control stop || return $?
	if [ "${1:-}" != "skip-backup" ]; then
		/usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/config_mirror.py mirror >/dev/null
	fi
}

lucky_restart()
{
    # Stop embedded writers before applying a newly restored XML snapshot.
    lucky_stop skip-backup || return $?
    /usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/config_mirror.py reconcile >/dev/null || return $?
    unset lucky_enable lucky_conf_dir lucky_http_port
    load_rc_config "$name"
	: "${lucky_enable:=YES}"
	: "${lucky_conf_dir:=/usr/local/etc/lucky}"
	: "${lucky_http_port:=16601}"
    if [ "$backup_force_restart" = "no" ] && ! checkyesno "$rcvar"; then
        /usr/local/bin/python3 /usr/local/opnsense/scripts/lucky/config_mirror.py mirror >/dev/null
        return $?
    fi
    lucky_prestart || return $?
    lucky_start
}

lucky_status()
{
	if lucky_control status; then
		echo "${name} is running."
		return 0
	fi
	echo "${name} is not running."
	return 1
}

run_rc_command "$1"
