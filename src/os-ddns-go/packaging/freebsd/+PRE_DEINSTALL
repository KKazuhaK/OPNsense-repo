#!/bin/sh

service os-ddns-go onestop >/dev/null 2>&1 \
    || { echo 'Scoped DDNS-Go shutdown failed; refusing unsafe removal.' >&2; exit 1; }
/usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py mirror >/dev/null 2>&1 || true
service os-ddns-go-backup onestop >/dev/null 2>&1 || true
exit 0
