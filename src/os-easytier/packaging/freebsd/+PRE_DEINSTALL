#!/bin/sh
service os-easytier-backup onestop >/dev/null 2>&1 || true
# The supervisor validates PID birth, interface ownership and every route.
# Refuse removal while an owned Core cannot be stopped; never kill names or
# destroy a same-name interface that belongs to another administrator.
/usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/network.py stop || exit 1
# Preserve administrator rules and same-named files in the legacy namespace.
/usr/local/bin/python3 /usr/local/opnsense/scripts/easytier/retire_legacy.py
