#!/bin/sh
set -eu

if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-ddns-go >/dev/null 2>&1 || true
fi
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuha.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuha.sh mirror >/dev/null 2>&1 \
        || echo 'Warning: Kazuha plugin restore manifest could not be updated.' >&2
fi

# Begin upgrade state restore.
mkdir -p /etc/rc.conf.d
if [ ! -f /etc/rc.conf.d/ddnsgo ]; then
    if [ -f /var/db/os-ddns-go/rc.conf.upgrade ]; then
        cp -p /var/db/os-ddns-go/rc.conf.upgrade /etc/rc.conf.d/ddnsgo
    else
        install -m 0644 /etc/rc.conf.d/ddnsgo.sample /etc/rc.conf.d/ddnsgo
    fi
fi
rm -f /var/db/os-ddns-go/rc.conf.upgrade
if [ -d /var/db/os-ddns-go/state.upgrade ]; then
    if [ ! -e /usr/local/etc/ddns-go ]; then
        mkdir -p /usr/local/etc
        cp -pR /var/db/os-ddns-go/state.upgrade /usr/local/etc/ddns-go
    fi
    rm -rf /var/db/os-ddns-go/state.upgrade
fi
# End upgrade state restore.

# A restored native snapshot takes precedence over installation defaults.
backup_result="$(/usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py import-config)" || {
    echo "===> Unable to restore the saved plugin configuration." >&2
    exit 1
}
backup_snapshot="$(printf '%s\n' "$backup_result" | /usr/local/bin/python3 -c 'import json,sys; print("yes" if json.load(sys.stdin).get("snapshot") else "no")')"


ABI="$(pkg config ABI 2>/dev/null || pkg -vv 2>/dev/null | awk -F'"' '/ABI =/ {print $2; exit}')"

case "$ABI" in
	FreeBSD:14:amd64|FreeBSD:15:amd64|FreeBSD:16:amd64)
		echo "===> Detected supported OPNsense ABI: $ABI"
		;;
	*)
		echo "===> Unsupported ABI: ${ABI:-unknown}" >&2
		echo "===> Supported: FreeBSD:14/15/16:amd64" >&2
		exit 1
		;;
esac

echo "===> Preparing DDNS-Go runtime"
mkdir -p /etc/rc.conf.d
if [ "$backup_snapshot" = "no" ]; then
    mkdir -p /usr/local/etc/ddns-go
fi
chmod 0755 /usr/local/bin/ddns-go /usr/local/etc/rc.d/os-ddns-go 2>/dev/null || true
chmod 0644 \
	/usr/local/opnsense/mvc/app/controllers/OPNsense/Ddnsgo/IndexController.php \
	/usr/local/opnsense/mvc/app/models/OPNsense/Ddnsgo/Menu/Menu.xml \
	/usr/local/opnsense/mvc/app/models/OPNsense/Ddnsgo/ACL/ACL.xml \
	/usr/local/opnsense/service/conf/actions.d/actions_ddnsgo.conf \
	/usr/local/share/opnsense-ddns-go/config.yaml.sample 2>/dev/null || true
if [ "$backup_snapshot" = "no" ] && [ ! -f /usr/local/etc/ddns-go/config.yaml ]; then
	install -m 0600 /usr/local/share/opnsense-ddns-go/config.yaml.sample /usr/local/etc/ddns-go/config.yaml
fi
touch /var/log/ddnsgo.log 2>/dev/null || true
chmod 0600 /var/log/ddnsgo.log 2>/dev/null || true

find /usr/local/opnsense/mvc/app/controllers/OPNsense/Ddnsgo /usr/local/opnsense/mvc/app/views/OPNsense/Ddnsgo /usr/local/opnsense/scripts/ddnsgo -type f -exec chmod 0644 {} \; 2>/dev/null || true

# Include existing settings in the next normal OPNsense configuration backup.
/usr/local/bin/python3 /usr/local/opnsense/scripts/ddnsgo/config_mirror.py mirror >/dev/null || {
    echo "===> Unable to save the plugin configuration backup." >&2
    exit 1
}
service os-ddns-go-backup start >/dev/null || {
    echo "===> Unable to start the plugin configuration backup watcher." >&2
    exit 1
}

# Remove the retired page when upgrading from a legacy package.
rm -f /usr/local/www/services_ddnsgo.php

echo "===> Clearing OPNsense menu and ACL cache"
rm -f \
	/var/lib/php/tmp/opnsense_menu_cache.xml \
	/var/lib/php/tmp/opnsense_acl_cache.json

echo "===> Reloading OPNsense menu, ACL and configd actions"
service configd restart >/dev/null 2>&1 || true
configctl webgui restart >/dev/null 2>&1 || service lighttpd onerestart >/dev/null 2>&1 || true

echo "===> Starting DDNS-Go service"
service os-ddns-go restart >/dev/null 2>&1 || true

if service os-ddns-go onestatus >/dev/null 2>&1; then
	echo "===> DDNS-Go for OPNsense installed. Refresh the browser and open Services > DDNS-Go."
else
	echo "===> Installed, but DDNS-Go did not report running. Check /var/log/ddnsgo.log." >&2
fi

exit 0
